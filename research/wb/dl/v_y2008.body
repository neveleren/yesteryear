	<div class="vlentry" >




		<div class="vlcontainer"><div class="v120WideEntry"><div class="v120WrapperOuter"><div class="v120WrapperInner"><a href="/watch?v=lhhGeDBsGA0" onmousedown="urchinTracker('/Events/VideoClicks/index/image/Simple Rube Goldberg Machine II');"><img src="http://i.ytimg.com/vi/lhhGeDBsGA0/default.jpg" class="vimg120" onload="urchinTrackerDefer('/Events/VideoClicks/index/imageLoaded/Simple Rube Goldberg Machine II');" title="Simple Rube Goldberg Machine II" alt="video"></a><div class="addtoQL90"><a href="#"  ql="lhhGeDBsGA0" title="Add Video to QuickList"><img class="QLIconImg" src="http://s.ytimg.com/yt/img/pixel-vfl73.gif" border="0"
	onclick="clicked_add_icon(this, this.parentNode.getAttribute('ql'), 0);_hbLink('QuickList+AddTo','na');return false;"
